{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "aurolight",
      "extra-files": [
        {
          "type": "xml",
          "path": "macos/Bundle/Info.plist",
          "xpath": "//dict/key[text()='CFBundleShortVersionString']/following-sibling::string[1]"
        },
        {
          "type": "xml",
          "path": "macos/Bundle/Info.plist",
          "xpath": "//dict/key[text()='CFBundleVersion']/following-sibling::string[1]"
        }
      ]
    }
  }
}
